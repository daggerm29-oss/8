    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.1.0"
  }
