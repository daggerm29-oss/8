{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
